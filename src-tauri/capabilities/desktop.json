{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "description": "Permissions backed by plugins and window features that only exist on desktop",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "autostart:default",
    "mcp-bridge:default",
    "core:app:allow-set-dock-visibility",
    "core:window:allow-set-skip-taskbar"
  ]
}
