{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aictionary",
  "version": "3.3.0",
  "identifier": "com.ahpx.aictionary-re",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aictionary",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Transparent"
      },
      {
        "label": "popup",
        "title": "Aictionary",
        "width": 315,
        "height": 360,
        "minWidth": 315,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4NkUyOTI3Mjg5NEVENkYKUldSdjdaUW9KeWx1NkJEeEN2U1NyNDN0cXVOajRHajllN2xJY0J6VTl1NHNjT3RFOGFOVnFGZTkK",
      "endpoints": [
        "https://github.com/ahpxex/Aictionary/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
